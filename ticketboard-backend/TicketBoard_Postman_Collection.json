			"name": "1. Authentication & Security",
			"item": [
				{
					"name": "Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set('jwt_token', jsonData.data.accessToken);",
									"    pm.environment.set('jwt_token', jsonData.data.accessToken);",
									"    console.log('JWT Token saved:', jsonData.data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@ticketboard.com\",\n    \"password\": \"Admin@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Authenticates user and returns JWT accessToken. Available demo accounts:\n- admin@ticketboard.com\n- pm@ticketboard.com\n- ba@ticketboard.com\n- lead@ticketboard.com\n- dev1@ticketboard.com\n- dev2@ticketboard.com\n- qa@ticketboard.com\n- mgmt@ticketboard.com\nPassword for all accounts: Admin@123"
					}
